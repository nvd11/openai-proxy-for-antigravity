# Server Configuration
PORT=3000
NODE_ENV=production

# Config Directory (defaults to ~/.config/antigravity-proxy)
CONFIG_DIR=

# Logging
LOG_LEVEL=info

# Optional: Override default endpoints
# ANTIGRAVITY_ENDPOINT=https://daily-cloudcode-pa.sandbox.googleapis.com

# Admin Dashboard
ADMIN_ENABLED=true

# Multimodal image input (image_url -> inlineData)
# Remote image URLs pointing at loopback/link-local/private ranges are blocked
# by default (SSRF guard). Set to "true" only for local development/testing.
# IMAGE_FETCH_ALLOW_PRIVATE=false
